# Copy to apps/api/.env and adjust for your machine.
# Values below match docker-compose.yml for local development.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/meantime
REDIS_URL=redis://localhost:6379

# Change both secrets before deploying anywhere real.
LEASE_HMAC_SECRET=dev-only-lease-secret-change-me
JWT_SECRET=dev-only-auth-secret-change-me

# S3-compatible local object storage (s3mock in docker-compose.yml). The SDK
# requires credentials; s3mock accepts any value.
S3_BUCKET=meantime
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1

PORT=3001
WEB_ORIGIN=http://localhost:3000

# Required (>= 16 chars). Salt for IP equality hashes; rotating it invalidates
# historical hash equality (see ARCHITECTURE.md section 10).
IP_HASH_SALT=dev-only-ip-salt-change-me

# Real Laya inference server (laya-serve) on :8000. Start it with
# `docker compose up -d`, or `./infra/laya-host.sh` when Docker is unavailable.
# For the offline test double, run `docker compose --profile stub up -d` and
# set LAYA_ENDPOINT=http://localhost:8080 instead.
LAYA_ENDPOINT=http://localhost:8000
LAYA_ENABLED=true

# Operator key for the /admin reviewer surface. Leave empty to disable it.
# The example value is dev-only — change it before deploying anywhere real.
# `pnpm smoke` loads this file, so setting it here exercises the reviewer
# surface (queue, campaign/task/payout decisions) in the smoke run.
ADMIN_API_KEY=dev-only-admin-key-change-me
LOG_LEVEL=info

# Email verification (Nodemailer)
# For Gmail, set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# and use an App Password (not your regular account password) in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MeanTime <noreply@meantime.app>"
