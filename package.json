{
  "name": "meantime",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @meantime/extension exec wxt prepare",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @meantime/api db:generate",
    "db:migrate": "pnpm --filter @meantime/api db:migrate",
    "db:seed": "pnpm --filter @meantime/api db:seed",
    "db:check": "pnpm --filter @meantime/api db:check",
    "test": "node scripts/test-unit.mjs",
    "smoke": "node scripts/smoke.mjs",
    "laya:check": "node scripts/laya-check.mjs",
    "laya:bench": "node scripts/laya-bench.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
